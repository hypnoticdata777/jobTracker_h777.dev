generator client {
  provider      = "prisma-client-js"
  // "native" corresponde al equipo local; el segundo destino es el entorno Linux de Vercel.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // url: conexión de la aplicación; en Neon utiliza agrupación de conexiones.
  // directUrl: conexión directa que Prisma utiliza para las migraciones.
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  jobs Job[]
}

enum JobStatus {
  SAVED
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
  ARCHIVED
}

model Job {
  id              Int       @id @default(autoincrement())
  title           String
  company         String
  location        String?
  description     String?
  url             String?
  notes           String?
  status          JobStatus @default(SAVED)
  // Fecha de envío de la postulación, sin hora.
  appliedAt       DateTime? @db.Date
  createdBy       Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  // Último cambio de estado, para medir después el tiempo en la etapa actual.
  statusChangedAt DateTime  @default(now())

  user User @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([createdBy, status])
}
