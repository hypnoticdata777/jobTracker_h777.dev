generator client {
  provider      = "prisma-client-js"
  // "native" is your own machine; the second target is the Linux runtime Vercel functions use.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // url: used by the running app. On Neon this is the pooled connection.
  // directUrl: used by the Prisma CLI for migrations, which need a direct connection.
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())

  jobs         Job[]
  applications Application[]
}

model Job {
  id          Int      @id @default(autoincrement())
  title       String
  company     String
  location    String?
  description String?
  url         String?
  createdBy   Int
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [createdBy], references: [id])
}

model Application {
  id        Int      @id @default(autoincrement())
  userId    Int
  jobId     Int?
  status    String   @default("saved")
  notes     String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}
