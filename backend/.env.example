# Local development: both URLs point at the same Docker database.
# In production DATABASE_URL is the pooled connection and
# DATABASE_URL_UNPOOLED is the direct one (used only for migrations).
DATABASE_URL="postgresql://jobtracker:password@localhost:5432/jobtracker_dev"
DATABASE_URL_UNPOOLED="postgresql://jobtracker:password@localhost:5432/jobtracker_dev"

# At least 16 characters. Generate one with: openssl rand -base64 32
JWT_SECRET="replace_with_a_strong_secret"
JWT_EXPIRES_IN="7d"
PORT=4000
