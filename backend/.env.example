# En desarrollo ambas direcciones apuntan a PostgreSQL de Docker.
# En producción DATABASE_URL usa agrupación de conexiones;
# DATABASE_URL_UNPOOLED es la conexión directa para migraciones.
DATABASE_URL="postgresql://jobtracker:password@localhost:5432/jobtracker_dev"
DATABASE_URL_UNPOOLED="postgresql://jobtracker:password@localhost:5432/jobtracker_dev"

# Al menos 16 caracteres. Genera una clave con: openssl rand -base64 32
JWT_SECRET="replace_with_a_strong_secret"
JWT_EXPIRES_IN="7d"
PORT=4000
